# SatyaDrishti (SatyaSetu-SIH) Environment Template

# ─── SatyaDrishti Backend Gmail API Configuration (Secure Backend Credentials) ───
ENABLE_GMAIL_DISPATCH=true
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-google-refresh-token
GMAIL_SENDER_EMAIL=your-testing-email@gmail.com
GMAIL_RECIPIENT_OVERRIDE=your-recipient-test-email@gmail.com


# SatyaDrishti Database Environment Configuration
# Default local PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/satyadrishti

# Or for hosted PostgreSQL (Supabase, Neon, AWS RDS, etc.):
# DATABASE_URL=postgresql://user:password@host:5432/database_name

# ─── SatyaDrishti Hybrid Multimodal Vision & Validation AI Configuration ─────
# Pollinations AI APIs (Priority 1 - Cloud Provider)
# Register & obtain API keys from https://enter.pollinations.ai/ (or leave empty for public tier)
POLLINATIONS_ENABLED=true

# 1. TEXT Model API (Used for OCR Text Parsing, Rule Disambiguation & Semantic Validation)
POLLINATIONS_TEXT_API_KEY=
POLLINATIONS_TEXT_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_TEXT_MODEL=openai

# 2. VISION Model API (Used for Packaging Multimodal Extraction & Physical Reference Detection)
POLLINATIONS_VISION_API_KEY=
POLLINATIONS_VISION_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_VISION_MODEL=openai

# Shared / Fallback API Key (Used if TEXT or VISION key is left empty)
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai

# 3. Reference Object Detection Pipeline
# YOLO reference code is preserved in the codebase but DISABLED by default (false).
# Metrology uses subpixel contour/gradient circle analysis + Vision API fallback.
ENABLE_YOLO_REFERENCE=false

# Local Ollama Vision LLM Server (Priority 2 Fallback)
# Install & run locally with: ollama run qwen2.5-vl
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5-vl

# Ollama inference tuning
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=550

# Cloud Vision LLM API (Priority 3 Fallback)
# Obtain free API key from https://aistudio.google.com/
GEMINI_API_KEY=

# ─── LLM Validation Augmentation Configuration ──────────────────────────────
# Max output tokens for validation LLM call — keep small for low latency.
LLM_VALIDATION_MAX_TOKENS=450

# ─── Autonomous E-Commerce Compliance Crawler Configuration ──────────────────
# ScraperAPI Key (Optional - 5,000 free requests/month at https://www.scraperapi.com)
SCRAPER_API_KEY=

# Jina AI Reader Key (Optional - Works free without key at https://jina.ai/reader)
JINA_API_KEY=

# Automated batch cadence in hours (Default: 24 for daily 5-product batch)
CRAWLER_AUTO_INTERVAL_HOURS=24


